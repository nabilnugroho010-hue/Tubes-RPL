{
    "name": "nabilnugroho010-hue/spgfood",
    "description": "Modern Restaurant Ordering System with Realtime Tracking",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-mysqli": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "SPGFood\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "*": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
